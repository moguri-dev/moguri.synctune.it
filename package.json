{
  "name": "moguri-website",
  "version": "1.0.0",
  "private": true,
  "description": "The Moguri website: landing, downloads, user guide and developer docs",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --check app.js && npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:links": "npm run build && node scripts/check-links.mjs",
    "sync:moguri": "node scripts/sync-moguri.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "marked": "18.1.3"
  }
}
